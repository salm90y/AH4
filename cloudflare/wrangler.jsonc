{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ah4-watch-party-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.ahmed1986y.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "ROOMS_DB",
      "database_name": "ah4-watch-party-rooms",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "migrations": [
    {
      "tag": "v2-delete-watch-room-durable-object",
      "deleted_classes": ["WatchRoom"]
    }
  ]
}
